# ========================================
# 招标信息管理系统环境变量配置示例
# ========================================
# 复制此文件为 .env 并修改相应的配置值

# ========================================
# 安全配置
# ========================================
# 应用密钥（生产环境必须修改为随机字符串）
SECRET_KEY=dev-secret-key-change-in-production

# ========================================
# 数据库配置
# ========================================
DB_HOST=localhost
DB_USER=bidding_user
DB_PASSWORD=your_database_password_here
DB_NAME=bidding_db
DB_PORT=3306
DB_CHARSET=utf8mb4

# ========================================
# 缓存配置
# ========================================
# 缓存类型：SimpleCache（内存）、RedisCache等
CACHE_TYPE=SimpleCache
# 缓存超时时间（秒）
CACHE_DEFAULT_TIMEOUT=300

# ========================================
# 速率限制配置
# ========================================
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_STRATEGY=fixed-window

# ========================================
# 访问控制
# ========================================
# 分析页面访问口令
ANALYSIS_ACCESS_CODE=kwd12345

# ========================================
# 用户配置
# ========================================
# 用户认证配置（格式：username:password_hash）
# 多个用户用分号分隔
# 使用 tools/generate_password.py 生成密码哈希
USERS_CONFIG=admin:pbkdf2:sha256:260000$example_hash_here

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
